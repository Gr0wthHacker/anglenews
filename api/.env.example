# AngleCheck API Environment Variables

# Required: Anthropic API key for Claude LLM calls
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Optional: NewsData.io API key (free tier available)
NEWSDATA_API_KEY=pub_xxxxx

# Optional: TheNewsAPI API key (free tier available)
THE_NEWS_API_KEY=xxxxx

# Server port (default: 3001)
PORT=3001

# Environment (development | production)
NODE_ENV=development
