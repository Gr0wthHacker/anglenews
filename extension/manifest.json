{
  "manifest_version": 3,
  "name": "AngleCheck",
  "version": "1.0.0",
  "description": "Compare news article angles across outlets. See how different sources frame the same story.",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://api.anglecheck.dev/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "options_page": "options/index.html",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  }
}
